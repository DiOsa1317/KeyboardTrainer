<Window x:Class="TypingTrainer.App.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TypingTrainer.App.ViewModels"
        xmlns:core="clr-namespace:TypingTrainer.Core;assembly=TypingTrainer.Core"
        x:DataType="vm:MainViewModel"
        Title="Typing Trainer" Width="850" Height="500"
        Focusable="True" TextInput="OnTextInput" KeyDown="OnKeyDown"
        Background="#121212">
        
    <StackPanel Margin="40" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
            <TextBlock Text="Выбор текста:" VerticalAlignment="Center" Foreground="#888888"/>
            <ComboBox ItemsSource="{Binding Lessons}" 
                      SelectedItem="{Binding SelectedLesson}" 
                      Width="300">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:Lesson">
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        
        <StackPanel Margin="20" Spacing="10" Width="400" HorizontalAlignment="Left">
            <TextBlock Text="Добавить свой текст" FontSize="18" FontWeight="Bold"/>
    
            <TextBox Watermark="Название текста (например: Мой код С#)" 
                     Text="{Binding NewLessonTitle, Mode=TwoWay}"/>
    
            <ComboBox SelectedValue="{Binding NewLessonLanguage}" SelectedIndex="0">
                <ComboBoxItem Content="ru"/>
                <ComboBoxItem Content="en"/>
            </ComboBox>
    
            <TextBox Watermark="Вставьте или напишите сюда текст тренажёра..." 
                     Text="{Binding NewLessonContent, Mode=TwoWay}"
                     AcceptsReturn="True" 
                     Height="150" 
                     TextWrapping="Wrap"/>
    
            <Button Content="Сохранить текст" 
                    Command="{Binding AddCustomLessonCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#2196F3" 
                    Foreground="White"/>
        </StackPanel>
        
        <TextBlock Text="Наберите текст:" FontSize="14" Foreground="#888888"/>
    
        <Border Background="#1E1E1E" 
                Padding="20" 
                CornerRadius="10" 
                MaxWidth="1600">
            <ItemsControl ItemsSource="{Binding CharacterItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CharValue}" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="{Binding Color}"
                                   TextDecorations="{Binding Decoration}"
                                   Width="{Binding Width}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid ColumnDefinitions="*,*" Margin="0,10">
            <TextBlock Grid.Column="0" Text="{Binding Wpm, StringFormat='WPM: {0:F1}'}" FontSize="22" Foreground="#4FC3F7"/>
            <TextBlock Grid.Column="1" Text="{Binding Accuracy, StringFormat='Точность: {0:F1}%'}" 
                       HorizontalAlignment="Right" FontSize="22" Foreground="#81C784"/>
        </Grid>

        <TextBlock Text="{Binding Status}" Foreground="#BDBDBD" Margin="0,5"/>
    
        <Button Content="Начать сначала (ESC)" Command="{Binding RestartCommand}" 
                HorizontalAlignment="Left" Width="180" Padding="10"/>
    </StackPanel>
</Window>